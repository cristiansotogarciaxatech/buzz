# HTTP service
MASTRA_MEMORY_BIND=127.0.0.1
MASTRA_MEMORY_PORT=4112
MASTRA_MEMORY_DATABASE_URL=postgresql://buzz_memory:buzz_memory_dev@127.0.0.1:5433/buzz_memory
MASTRA_MEMORY_SCHEMA=buzz_mastra_memory
# Required for non-loopback binds. Use at least 24 random characters.
# MASTRA_MEMORY_AUTH_TOKEN=

# Mastra Observer and Reflector models
MASTRA_OBSERVER_MODEL=codex/gpt-5.6-sol
MASTRA_REFLECTOR_MODEL=codex/gpt-5.6-sol
MASTRA_CODEX_REASONING_EFFORT=low
# MASTRA_CODEX_PATH=/absolute/path/to/codex
# MASTRA_CODEX_WORKING_DIRECTORY=/absolute/path/to/empty/read-only-workspace

# Observational memory thresholds
MASTRA_OBSERVATION_MESSAGE_TOKENS=6000
MASTRA_REFLECTION_OBSERVATION_TOKENS=12000
MASTRA_PREVIOUS_OBSERVER_TOKENS=2000

# Retrieval and context budgets
MASTRA_SEMANTIC_TOP_K=4
MASTRA_PROJECT_TOKEN_BUDGET=1800
MASTRA_CHANNEL_TOKEN_BUDGET=2200
MASTRA_SEMANTIC_TOKEN_BUDGET=1500
MASTRA_TOTAL_TOKEN_BUDGET=5500

# Request bounds
MASTRA_MAX_BODY_BYTES=262144
MASTRA_MAX_TURN_CHARS=65536
